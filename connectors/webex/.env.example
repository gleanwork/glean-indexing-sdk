# Webex compliance connector — runtime configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Webex source auth (Compliance Officer credential for org-wide reads) ---
# Scopes required: spark-compliance:events_read, spark-compliance:memberships_read, spark:people_read
WEBEX_ACCESS_TOKEN=

# Optional overrides
# WEBEX_BASE_URL=https://webexapis.com/v1
# WEBEX_LOOKBACK_DAYS=89   # coverage window; hard-capped at 90 by Webex

# --- Glean indexing target ---
GLEAN_SERVER_URL=
GLEAN_INDEXING_API_TOKEN=
