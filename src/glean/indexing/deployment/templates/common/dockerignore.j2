# Generated by glean-idx deploy init — excludes files that must not enter the container image.

# Terraform state and provider cache — runtime infrastructure, not connector code.
terraform/
.terraform/
*.tfstate
*.tfstate.backup

# Credentials and local secret metadata — never bake them into images.
.env
.env.*
.glean_secret_keys

# Python cache
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/

# Tests and local tools
tests/
test_*.py
tmp/

# Planning and documentation
.glean/
*.md

# Version control and IDE
.git/
.gitignore
.idea/
.vscode/
