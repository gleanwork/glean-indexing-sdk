# Generated by glean-idx deploy init --cloud gcp
# DO NOT EDIT THIS FILE MANUALLY — re-run glean-idx deploy init to regenerate.
#
# References:
#   Terraform:              https://developer.hashicorp.com/terraform/docs
#   GCP Provider:           https://registry.terraform.io/providers/hashicorp/google/latest/docs
#   GKE CronJob:            https://kubernetes.io/docs/concepts/workloads/controllers/cron-jobs/
#   GCP Secret Manager:     https://cloud.google.com/secret-manager/docs
#   GCP Workload Identity:  https://cloud.google.com/kubernetes-engine/docs/how-to/workload-identity
#   GCP Cloud Monitoring:   https://cloud.google.com/monitoring/docs

terraform {
  required_version = ">= 1.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 4.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = ">= 2.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

data "google_client_config" "default" {}

data "google_container_cluster" "main" {
  name     = var.cluster_name
  location = var.region
}

locals {
  secret_keys = toset(jsondecode(var.secret_keys_json))
  secret_names = {
    for key in local.secret_keys : key => "${var.secret_prefix}${key}"
  }
}

provider "kubernetes" {
  # For private-only GKE clusters (enablePublicEndpoint: false) set cluster_endpoint in
  # glean_deployment.yaml to the GKE DNS endpoint (*.gke.goog); Terraform will use that instead
  # of the private IP returned by the cluster data source.
  # Reference: https://cloud.google.com/kubernetes-engine/docs/concepts/cluster-architecture#control_plane_endpoint_modes
  host                   = "https://${coalesce(var.cluster_endpoint, data.google_container_cluster.main.endpoint)}"
  token                  = data.google_client_config.default.access_token
  cluster_ca_certificate = var.cluster_endpoint == null ? base64decode(data.google_container_cluster.main.master_auth[0].cluster_ca_certificate) : null
}

# ----- Service Account -----
# Least-privilege IAM for the connector pod.
# Reference: https://cloud.google.com/kubernetes-engine/docs/how-to/workload-identity

resource "google_service_account" "connector" {
  account_id   = var.service_account_name
  display_name = "Glean connector: ${var.connector_name}"
  project      = var.project_id
}

# Allow writing structured logs.
# Reference: https://cloud.google.com/logging/docs/access-control
resource "google_project_iam_member" "log_writer" {
  project = var.project_id
  role    = "roles/logging.logWriter"
  member  = "serviceAccount:${google_service_account.connector.email}"
}

# Allow emitting custom metrics.
# Reference: https://cloud.google.com/monitoring/docs/access-control
resource "google_project_iam_member" "metric_writer" {
  project = var.project_id
  role    = "roles/monitoring.metricWriter"
  member  = "serviceAccount:${google_service_account.connector.email}"
}

# Bind GCP service account to Kubernetes service account via Workload Identity.
# Reference: https://cloud.google.com/kubernetes-engine/docs/how-to/workload-identity
resource "google_service_account_iam_member" "workload_identity" {
  service_account_id = google_service_account.connector.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "serviceAccount:${var.project_id}.svc.id.goog[${data.kubernetes_namespace_v1.target.metadata[0].name}/${var.k8s_name}-ksa]"
}

# Allow accessing only the exact declared secret values at runtime.
# Reference: https://cloud.google.com/secret-manager/docs/access-control
resource "google_secret_manager_secret_iam_member" "secret_accessor" {
  for_each  = local.secret_names
  project   = var.project_id
  secret_id = each.value
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.connector.email}"
}

data "kubernetes_namespace_v1" "target" {
  metadata {
    name = var.namespace
  }
}

resource "kubernetes_service_account_v1" "connector" {
  metadata {
    name      = "${var.k8s_name}-ksa"
    namespace = data.kubernetes_namespace_v1.target.metadata[0].name
    annotations = {
      "iam.gke.io/gcp-service-account" = google_service_account.connector.email
    }
  }
}

# ----- CronJob -----
# Reference: https://kubernetes.io/docs/concepts/workloads/controllers/cron-jobs/

resource "kubernetes_cron_job_v1" "connector" {
  metadata {
    name      = var.k8s_name
    namespace = data.kubernetes_namespace_v1.target.metadata[0].name
    labels = {
      app = var.k8s_name
      # Not "glean-idx deploy": Kubernetes label values cannot contain spaces.
      managed-by = "glean-idx"
    }
  }

  spec {
    schedule                      = var.cron_schedule
    concurrency_policy            = "Forbid"
    failed_jobs_history_limit     = 3
    successful_jobs_history_limit = 3

    job_template {
      metadata {
        labels = {
          app = var.k8s_name
        }
      }
      spec {
        backoff_limit = 1
        template {
          metadata {
            labels = {
              app = var.k8s_name
            }
          }
          spec {
            service_account_name = kubernetes_service_account_v1.connector.metadata[0].name
            restart_policy       = "Never"

            container {
              name  = var.k8s_name
              image = var.image

              # Deployment-control env vars — NOT loaded from secret manager.
              env {
                name  = "DATASOURCE_NAME"
                value = var.connector_name
              }
              env {
                name  = "CLOUD_PLATFORM"
                value = "gcp"
              }
              env {
                name  = "INDEXING_MODE"
                value = var.indexing_mode
              }
              env {
                name  = "GOOGLE_CLOUD_PROJECT"
                value = var.project_id
              }
              env {
                name  = "SECRET_KEYS_JSON"
                value = var.secret_keys_json
              }
              env {
                name  = "CONNECTOR_CLASS"
                value = var.connector_class
              }
              env {
                name  = "CONNECTOR_MODULE"
                value = var.connector_module
              }
              dynamic "env" {
                for_each = var.connector_factory == null ? [] : [var.connector_factory]
                content {
                  name  = "CONNECTOR_FACTORY"
                  value = env.value
                }
              }

              resources {
                requests = {
                  cpu    = var.cpu
                  memory = var.memory
                }
                limits = {
                  cpu    = var.cpu
                  memory = var.memory
                }
              }

              # No privileged mode, no extra capabilities. Keep these numeric
              # IDs in sync with the generated Dockerfile.
              security_context {
                allow_privilege_escalation = false
                run_as_non_root            = true
                run_as_user                = 1000
                run_as_group               = 1000
              }
            }
          }
        }
      }
    }
  }
}
